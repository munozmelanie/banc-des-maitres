{
  "name": "banc-des-maitres",
  "version": "1.0.0",
  "private": true,
  "description": "Fluence CM1 : lecture, écho, chœur et défi d’une minute, avec télécommande iPhone.",
  "scripts": {
    "build": "python3 outils/build.py",
    "hors-ligne": "python3 outils/build.py --hors-ligne",
    "test": "python3 outils/build.py && node tests/import-classe.js && node tests/app.js",
    "voix": "python3 outils/voix.py",
    "images": "python3 outils/images.py",
    "sync": "python3 outils/build.py && npx cap sync",
    "test:classe": "python3 outils/build.py && node tests/import-classe.js"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "playwright": "^1.63.0",
    "ws": "^8.18.0"
  }
}
