# Copier ce fichier à la racine du dépôt sous le nom .iphone.local.env.
# Ce fichier local est ignoré par Git. Ne jamais publier de certificats ou de profils Apple.
# Valeurs à retrouver avec les commandes indiquées dans le README.
BANC_IPHONE_DEVICE='identifiant-UDID-de-l-iphone'
BANC_DEVELOPMENT_TEAM='identifiant-equipe-Apple'
BANC_PROVISIONING_PROFILE='nom-du-profil-de-developpement-existant'
BANC_CODE_SIGN_IDENTITY='empreinte-SHA1-du-certificat-existant'
# Facultatif : chemins complets si les commandes habituelles ne conviennent pas.
# BANC_NODE='/chemin/vers/node-22-ou-plus'
# BANC_PYTHON='/chemin/vers/python3'
# DEVELOPER_DIR='/Applications/Xcode.app/Contents/Developer'
